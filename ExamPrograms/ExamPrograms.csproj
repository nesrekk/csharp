<Project Sdk="Microsoft.NET.Sdk">

  <!-- 30 stand-alone exam programs, each with its own Main.
       Run one with:  run.bat 7  (Windows)   or   ./run.sh 7  (Mac/Linux)
       Works with any installed .NET SDK (6, 7, 8, 9, 10...): the target framework follows the SDK. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net$(NETCoreAppMaximumVersion)</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <StartupObject>Q01_Fibonacci.Program</StartupObject>
  </PropertyGroup>

</Project>
